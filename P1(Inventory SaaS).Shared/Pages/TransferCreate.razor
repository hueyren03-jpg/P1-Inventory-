@page "/transfers/new"
@inject UiShellService Ui
@inject IInventoryUiService Data
@inject NavigationManager Navigation

<PageTitle>New Stock Transfer - P1 Inventory</PageTitle>
<div class="breadcrumb"><a href="javascript:history.back()">Back</a><span>/</span><span>New Stock Transfer</span></div>
<PageHeader Title="New Stock Transfer" Subtitle="Move inventory between branches with scan-first, touch-first controls." />

<section class="panel form-page pos-form-page touch-workflow-page">
    <div class="touch-workflow-steps"><span class="active">1 Route</span><span>2 Product</span><span>3 Quantity</span><span>4 Confirm</span></div>

    <FormSection Title="Transfer route" Description="Choose source and destination using large searchable touch sheets.">
        <div class="touch-form-grid">
            <TouchSelectField Label="From branch" @bind-Value="fromBranch" Options="branches" />
            <TouchSelectField Label="To branch" @bind-Value="toBranch" Options="branches" />
            <TouchDateField Label="Expected date" @bind-Value="expectedDate" />
            <TouchSelectField Label="Priority" @bind-Value="priority" Options="priorities" Searchable="false" />
        </div>
        @if (fromBranch == toBranch)
        {
            <div class="touch-inline-error"><strong>!</strong><span>Source and destination cannot be the same branch.</span></div>
        }
    </FormSection>

    <FormSection Title="Transfer line" Description="Pick or scan a product, select storage areas, then enter quantity with the keypad.">
        <div class="touch-form-grid">
            <div class="span-2"><TouchProductPicker @bind-Value="product" /></div>
            <TouchSelectField Label="Source area" @bind-Value="sourceArea" Options="sourceAreas" />
            <TouchSelectField Label="Destination area" @bind-Value="destinationArea" Options="destinationAreas" />
            <div class="touch-stock-snapshot"><span>Available at source</span><strong>@availableAtSource units</strong><small>@fromBranch · @sourceArea</small></div>
            <div class="span-2 touch-field-block">
                <span class="touch-field-label">Quantity</span>
                <TouchQuantityControl @bind-Value="quantity" Presets="transferPresets" Max="availableAtSource" MaxShortcut="availableAtSource" Label="Transfer quantity" ContextText="Enter the transfer quantity. MAX uses all currently available source stock." />
            </div>
        </div>

        <div class="touch-transfer-route">
            <div><span>FROM</span><strong>@fromBranch</strong><small>@sourceArea</small></div>
            <span class="touch-route-line">→</span>
            <div><span>TO</span><strong>@toBranch</strong><small>@destinationArea</small></div>
        </div>
    </FormSection>

    <FormSection Title="Notes" Description="Optional receiving or handling instructions.">
        <div class="form-grid"><label class="span-2"><span>Transfer notes</span><textarea rows="3" placeholder="Optional instructions"></textarea></label></div>
    </FormSection>

    <div class="form-actions pos-form-actions">
        <a class="btn btn-secondary" href="/transfers">Cancel</a>
        <button class="btn btn-primary pos-primary-action" type="button" disabled="@InvalidRoute" @onclick="ConfirmAsync">Create Transfer · @quantity units</button>
    </div>
</section>

@code {
    private string fromBranch = "Kuala Lumpur";
    private string toBranch = "Petaling Jaya";
    private string priority = "Normal";
    private string product = "Running Tee / Black / M";
    private string sourceArea = "Main Floor APP-02-08";
    private string destinationArea = "Receiving Area";
    private DateTime expectedDate = DateTime.Today.AddDays(1);
    private int availableAtSource = 146;
    private int quantity = 80;

    private readonly IReadOnlyList<string> branches = ["Kuala Lumpur", "Petaling Jaya", "Penang", "Johor Bahru"];
    private readonly IReadOnlyList<string> priorities = ["Normal", "Urgent"];
    private readonly IReadOnlyList<string> sourceAreas = ["Main Floor APP-02-08", "Back Room", "Dispatch Area"];
    private readonly IReadOnlyList<string> destinationAreas = ["Receiving Area", "Main Floor", "Back Room"];
    private readonly IReadOnlyList<int> transferPresets = [1, 5, 10, 25, 50, 100];

    private bool InvalidRoute => fromBranch == toBranch || quantity <= 0;

    private async Task ConfirmAsync()
    {
        if (InvalidRoute) return;
        var confirmed = await Ui.ConfirmAsync("Create stock transfer?", $"Move {quantity:N0} units of {product} from {fromBranch} to {toBranch}.", "Create transfer", "info");
        if (!confirmed) return;

        var transfer = await Data.CreateTransferAsync(new TransferDraft(
            fromBranch, toBranch, quantity, DateOnly.FromDateTime(expectedDate), 1));
        Ui.ShowToast("Transfer created", $"{transfer.Number} · {quantity:N0} units scheduled from {fromBranch} to {toBranch}.", "success");
        Navigation.NavigateTo("/transfers");
    }
}
