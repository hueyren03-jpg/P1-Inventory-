@page "/organization/company"
<PageTitle>Company Profile - P1 Inventory</PageTitle>
<div class="breadcrumb"><a href="javascript:history.back()">Back</a><span>/</span><span>Company Profile</span></div>
<PageHeader Title="Company Profile" Subtitle="Manage legal and operational organization details." />
<section class="panel form-page"><FormSection Title="Company details" Description="Shown on documents and billing."><div class="form-grid"><label><span>Company name</span><input type="text" value="Apex Retail Sdn Bhd" /></label><label><span>Registration number</span><input type="text" value="202601234567" /></label><label><span>Tax number</span><input type="text" value="C1234567890" /></label><label><span>Default currency</span><select><option>MYR — Malaysian Ringgit</option></select></label></div></FormSection><FormSection Title="Contact" Description="Primary organization contact."><div class="form-grid"><label><span>Email</span><input type="email" value="operations@example.com" /></label><label><span>Phone</span><input type="text" value="+60 3-0000 0000" /></label><label class="span-2"><span>Address</span><textarea rows="4" placeholder="Kuala Lumpur, Malaysia"></textarea></label></div></FormSection><div class="form-actions"><a class="btn btn-secondary" href="/settings">Cancel</a><button class="btn btn-primary">Save company profile</button></div></section>
