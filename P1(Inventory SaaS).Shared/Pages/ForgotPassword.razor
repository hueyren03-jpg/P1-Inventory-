@page "/forgot-password"
@layout P1_Inventory_SaaS_.Shared.Layout.AuthLayout
@inject UiShellService Ui
<PageTitle>Reset password - P1 Inventory</PageTitle><section class="auth-card"><div class="auth-card-head"><h1>Reset your password</h1><p>Enter your email and we’ll send reset instructions.</p></div><label><span>Email</span><input type="email" @bind="email"/></label><button class="btn btn-primary auth-submit" disabled="@string.IsNullOrWhiteSpace(email)" @onclick="SendReset">Send reset link</button><p class="auth-bottom"><a href="/login">Back to sign in</a></p></section>

@code {
    private string email = "";
    private void SendReset() => Ui.ShowToast("Reset link sent", $"Mock reset instructions were sent to {email}.", "success");
}
