@page "/roles"
<PageTitle>Roles & Permissions - P1 Inventory</PageTitle>
<PageHeader Title="Roles & permissions" Subtitle="Control what users can do and which inventory resources they can access."><Actions><button class="btn btn-primary"><AppIcon Name="plus" Size="15"/> New role</button></Actions></PageHeader>
<section class="role-grid"><article class="panel role-list"><button class="role-item active"><span><strong>Administrator</strong><small>5 users</small></span><StatusPill Text="System" Tone="info"/></button><button class="role-item"><span><strong>Inventory Manager</strong><small>3 users</small></span></button><button class="role-item"><span><strong>Warehouse Manager</strong><small>4 users</small></span></button><button class="role-item"><span><strong>Warehouse Staff</strong><small>18 users</small></span></button><button class="role-item"><span><strong>Auditor</strong><small>2 users</small></span></button></article><article class="panel permission-panel"><div class="panel-header"><div><h2>Administrator</h2><p>Full operational access except billing ownership.</p></div><button class="btn btn-secondary">Duplicate role</button></div><div class="permission-groups"><div><h3>Catalog</h3><label><input type="checkbox" checked/> View products</label><label><input type="checkbox" checked/> Create products</label><label><input type="checkbox" checked/> Update products</label></div><div><h3>Inventory</h3><label><input type="checkbox" checked/> View inventory</label><label><input type="checkbox" checked/> Post stock operations</label><label><input type="checkbox" checked/> Approve adjustments</label></div><div><h3>Purchasing</h3><label><input type="checkbox" checked/> Create purchase orders</label><label><input type="checkbox" checked/> Approve purchase orders</label><label><input type="checkbox" checked/> Receive goods</label></div><div><h3>Administration</h3><label><input type="checkbox" checked/> Manage users</label><label><input type="checkbox" checked/> View audit log</label></div></div><div class="form-actions"><button class="btn btn-primary">Save permissions</button></div></article></section>
