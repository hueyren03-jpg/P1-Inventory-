@page "/brands"

<PageTitle>Brands - P1 Inventory</PageTitle>
<PageHeader Title="Brands" Subtitle="Maintain product brands used by your catalog.">
    <Actions><a class="btn btn-primary" href="#"><AppIcon Name="plus" Size="15" /> Add brand</a></Actions>
</PageHeader>

<section class="panel list-panel">
    <Toolbar SearchPlaceholder="Search brands" ResultText="@($"{rows.Count} records")" />
    <SimpleTable Headers="headers" Rows="rows" StatusColumn="3" LinkColumn="-1" LinkBase="#" />
    <div class="pagination"><span>Showing all sample records</span><div><button class="btn btn-secondary compact" disabled>Previous</button><button class="btn btn-secondary compact" disabled>Next</button></div></div>
</section>

@code {
    private readonly IReadOnlyList<string> headers = ["Brand", "Products", "Supplier count", "Status"];
    private readonly IReadOnlyList<IReadOnlyList<string>> rows = [
        ["DockPro", "228", "3", "Active"],
        ["RunEight", "184", "2", "Active"],
        ["PackPro", "92", "1", "Active"],
        ["NorthLabel", "64", "1", "Active"]
    ];
}
