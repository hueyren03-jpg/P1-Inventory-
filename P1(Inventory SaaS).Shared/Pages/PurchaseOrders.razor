@page "/purchase-orders"
@inject IInventoryUiService Data
@inject UiShellService Ui

<PageTitle>Purchase Orders - P1 Inventory</PageTitle>

<PageHeader Title="Purchase orders" Subtitle="Track purchasing from draft through receiving.">
    <Actions>
        <a class="btn btn-primary" href="/purchase-orders/new"><AppIcon Name="plus" Size="15" /> New purchase order</a>
    </Actions>
</PageHeader>

<section class="panel list-panel">
    <div class="tabbar table-tabs">
        @foreach (var status in statuses)
        {
            <button class="tab @(activeStatus == status ? "active" : "")" @onclick="() => SetStatus(status)">@status</button>
        }
    </div>

    <div class="list-toolbar">
        <div class="toolbar-search"><AppIcon Name="search" Size="16" /><input @bind="search" @bind:event="oninput" placeholder="Search PO or supplier" /></div>
        <button class="btn btn-secondary" @onclick="ClearFilters"><AppIcon Name="filter" Size="15" /> Filters</button>
    </div>

    <div class="table-wrap">
        <table class="data-table">
            <thead>
                <tr>
                    <th>PO number</th>
                    <th>Supplier</th>
                    <th>Warehouse</th>
                    <th>Order date</th>
                    <th>Expected</th>
                    <th class="numeric">Items</th>
                    <th class="numeric">Total</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var row in FilteredRows)
                {
                    <tr>
                        <td><a class="record-link" href="@($"/purchase-orders/{row.Number}")">@row.Number</a></td>
                        <td>@row.Supplier</td>
                        <td>@row.Warehouse</td>
                        <td>@row.OrderDate.ToString("dd MMM yyyy")</td>
                        <td>@row.ExpectedDate.ToString("dd MMM yyyy")</td>
                        <td class="numeric">@row.Items</td>
                        <td class="numeric">RM @row.Total.ToString("N2")</td>
                        <td><StatusPill Text="@row.Status" Tone="@Tone(row.Status)" /></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</section>

@code {
    private IReadOnlyList<PurchaseOrderRow> rows = [];
    private readonly string[] statuses = ["All", "Draft", "Pending approval", "Approved", "Sent", "Receiving"];
    private string activeStatus = "All";
    private string search = "";

    private IEnumerable<PurchaseOrderRow> FilteredRows => rows.Where(row =>
        (string.IsNullOrWhiteSpace(search) || row.Number.Contains(search, StringComparison.OrdinalIgnoreCase) || row.Supplier.Contains(search, StringComparison.OrdinalIgnoreCase)) &&
        (activeStatus == "All" || StatusMatches(row.Status, activeStatus)));

    protected override async Task OnInitializedAsync()
        => rows = await Data.GetPurchaseOrdersAsync();

    private void SetStatus(string status) => activeStatus = status;
    private void ClearFilters()
    {
        activeStatus = "All";
        search = "";
        Ui.ShowToast("Filters cleared", "Showing all purchase orders.", "info");
    }

    private static bool StatusMatches(string rowStatus, string filter) => filter switch
    {
        "Pending approval" => rowStatus == "Pending Approval",
        "Receiving" => rowStatus is "Partially Received" or "Received",
        _ => rowStatus.Equals(filter, StringComparison.OrdinalIgnoreCase)
    };

    private static string Tone(string status) => status switch
    {
        "Approved" => "success",
        "Pending Approval" => "warning",
        "Partially Received" => "info",
        "Sent" => "info",
        _ => "neutral"
    };
}
