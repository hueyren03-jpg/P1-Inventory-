@page "/settings"
<PageTitle>Settings - P1 Inventory</PageTitle><PageHeader Title="Settings" Subtitle="Configure organization, inventory, purchasing, notifications and security." />
<div class="settings-layout"><aside class="settings-nav"><button class="active">General</button><a href="/organization/company">Company profile</a><button>Inventory</button><button>Purchasing</button><button>Sales</button><button>Warehouse</button><button>Tax & currency</button><button>Notifications</button><button>Security</button><a href="/integrations/import-export">Data management</a></aside><section class="panel settings-panel"><FormSection Title="Organization defaults" Description="Applied to new records unless a module overrides them."><div class="form-grid"><label><span>Default warehouse</span><select><option>KL Central Warehouse</option></select></label><label><span>Currency</span><select><option>MYR — Malaysian Ringgit</option></select></label><label><span>Timezone</span><select><option>Asia/Kuala_Lumpur</option></select></label><label><span>Date format</span><select><option>DD MMM YYYY</option></select></label></div></FormSection><FormSection Title="Inventory controls" Description="Safe defaults for stock operations."><div class="form-grid"><label class="toggle-field"><span><strong>Prevent negative inventory</strong><small>Block posting that would reduce available stock below zero.</small></span><input type="checkbox" checked/></label><label class="toggle-field"><span><strong>Require adjustment approval</strong><small>Approval required above configured thresholds.</small></span><input type="checkbox" checked/></label></div></FormSection><div class="form-actions"><button class="btn btn-secondary">Discard</button><button class="btn btn-primary">Save changes</button></div></section></div>
